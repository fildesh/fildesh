# There are several tests. Search for:
# - message_sxpb
# - dict_sxpb
# - loneof_sxpb
# - array_sxpb
# - manyof_sxpb
# - string_sxpb
# - nest_sxpb

(: message_sxpb Filepath .self.opt.message_sxpb)
(: message_json Filepath .self.opt.message_json)

|< splice / / $(XOF message_sxpb)
|- sxpb2sxpb
|- sxpb2json
|- cmptxt $(XOF message_json)
|> stdout


$(barrier)

