load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:0BSD"],
    license_text = "LICENSE",
)

exports_files([
    "LICENSE",
    "MODULE.bazel",
    "README.md",
])

alias(
    name = "fildesh",
    actual = "//src/bin:fildesh",
)

alias(
    name = "sxproto_lib",
    actual = "//src/sxproto:sxproto_lib",
)

cc_library(
    name = "fildesh_compat_lib",
    srcs = [
        "//compat:env.c",
        "//compat:errno.c",
        "//compat:fd.c",
        "//compat:fd_exclusive.h",
        "//compat:file.c",
        "//compat:kill.c",
        "//compat:random.c",
        "//compat:sh.c",
        "//compat:string.c",
        "//compat:tmpdir.c",
        "//include/fildesh:fildesh_compat_errno.h",
        "//include/fildesh:fildesh_compat_fd.h",
        "//include/fildesh:fildesh_compat_file.h",
        "//include/fildesh:fildesh_compat_random.h",
        "//include/fildesh:fildesh_compat_sh.h",
        "//include/fildesh:fildesh_compat_string.h",
    ],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:windows": [
            "-DEFAULTLIB:advapi32.lib",  # For RtlGenRandom().
        ],
        "//conditions:default": ["-pthread"],
    }),
)

cc_library(
    name = "fildesh_lib",
    srcs = [
        "//include/fildesh:fildesh.h",
        "//src/lib:alloc.c",
        "//src/lib:array.c",
        "//src/lib:log.c",
        "//src/lib:mascii.c",
        "//src/lib:mascii.h",
        "//src/lib:string.c",
        "//src/lib/kv:brbtree.c",
        "//src/lib/kv:bstree.c",
        "//src/lib/kv:bstree.h",
        "//src/lib/kv:kv.c",
        "//src/lib/kv:kv.h",
        "//src/lib/kv:kve.c",
        "//src/lib/kv:kve.h",
        "//src/lib/kv:rbtree.c",
        "//src/lib/kv:single_list.c",
        "//src/lib/xo:infile.c",
        "//src/lib/xo:instream.c",
        "//src/lib/xo:outfile.c",
        "//src/lib/xo:outstream.c",
    ],
    includes = ["include"],
    deps = [":fildesh_compat_lib"],
)

cc_library(
    name = "fildesh_cc_lib",
    srcs = [
        "//include/fildesh:istream.hh",
        "//include/fildesh:ostream.hh",
        "//include/fildesh:streambuf.hh",
        "//include/fildesh:string.hh",
    ],
    includes = ["include"],
    deps = [":fildesh_lib"],
)

cc_library(
    name = "fildesh_tool_lib",
    srcs = [
        "//include:fildesh_posix_thread.h",
        "//include:fildesh_tool.h",
        "//tool:pipem.c",
    ],
    includes = ["include"],
    deps = [":fildesh_compat_lib"],
)
